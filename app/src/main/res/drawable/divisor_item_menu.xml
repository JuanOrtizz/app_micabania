<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <!-- Fondo transparente del item -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                </shape>
            </item>

            <!-- Linea separadora de los items en el borde de abajo -->
            <item android:bottom="0dp" android:left="16dp" android:right="16dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <size android:height="1dp" />
                    <solid android:color="@color/grisEditText"/>
                </shape>
            </item>
        </layer-list>
    </item>

</selector>