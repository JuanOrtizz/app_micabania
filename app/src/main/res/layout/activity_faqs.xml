<androidx.drawerlayout.widget.DrawerLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/drawer_layout"
android:layout_width="match_parent"
android:layout_height="match_parent">

    <!--Layout global de la vista-->
    <LinearLayout android:orientation="vertical"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:background="@color/verdeFondoApp"
        android:gravity="start">

        <!--ConstraintLayout para la barra de navegacion (menu hamburguesa)-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verdeHeader"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!--Boton menu hamburguesa-->
            <ImageButton
                android:id="@+id/btnMenuHamburguesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_menu_hamburguesa"
                android:background="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingStart="30dp"/>

            <!--Icono app-->
            <ImageView
                android:id="@+id/logoApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_header"
                android:contentDescription="Logo de la app"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--Scroll view para las preguntas frecuentes-->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--Titulo de la seccion FAQs-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FAQs y Tutoriales"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:textColor="@color/negro"
                    />

                <!--LinearLayout para las preguntas recientes-->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    >

                    <!--LinearLayout para una pregunta-->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:background="@drawable/layout_faqs"
                        android:layout_marginBottom="24dp">

                        <!--Titulo de la pregunta-->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="¿Cómo registrar una propiedad?"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/blanco"
                            android:layout_marginBottom="6dp"
                            android:gravity="center"
                            />

                        <!--Texto de la pregunta-->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="En el menú principal de la aplicación, puedes agregar una propiedad seleccionando la opción correspondiente y completando el formulario. Luego, debes presionar el botón *Registrar propiedad* para finalizar el proceso."
                            android:textSize="15sp"
                            android:textColor="@color/blanco"
                            />

                    </LinearLayout>

                    <!--LinearLayout para una pregunta-->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:background="@drawable/layout_faqs"
                        android:layout_marginBottom="24dp">

                        <!--Titulo de la pregunta-->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="¿Cómo visualizar el inventario de una propiedad?"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/blanco"
                            android:layout_marginBottom="6dp"
                            android:gravity="center"
                            />

                        <!--Texto de la pregunta-->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Para ver el inventario de una propiedad, accede a la propiedad deseada. Una vez dentro, encontrarás las distintas categorías del inventario y, dentro de cada una, los elementos previamente registrados."
                            android:textSize="15sp"
                            android:textColor="@color/blanco"
                            />

                    </LinearLayout>

                    <!--LinearLayout para una pregunta-->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/layout_faqs">

                        <!--Titulo de la pregunta-->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="¿Cómo agregar un elemento al inventario?"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/blanco"
                            android:layout_marginBottom="6dp"
                            android:gravity="center"
                            />

                        <!--Texto de la pregunta-->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Para añadir un elemento al inventario, accede a la categoría correspondiente y selecciona la opción *Agregar elemento*. Luego, completa el formulario con el nombre y la cantidad de stock del elemento. Si deseas eliminar un elemento del stock o eliminarlo por completo, selecciona el elemento en cuestión y elige entre las opciones de *Restar stock* o *Eliminar elemento*. También puedes agregar unidades individuales sin necesidad de crear nuevamente el elemento para actualizar su stock."
                            android:textSize="15sp"
                            android:textColor="@color/blanco"
                            />
                    </LinearLayout>

                </LinearLayout>

                <!--View para agregar espacio al scrollview-->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:visibility="invisible" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Menu lateral (el drawer, es decir menu hamburguesa) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:menu="@menu/drawer_menu"
        android:layout_gravity="start"
        android:background="@color/blanco"
        android:paddingTop="24dp"
        app:itemTextColor="@color/verdeElementosMenu"
        app:itemTextAppearance="@style/TextoMenuDrawer"
        app:itemBackground="@drawable/divisor_item_menu"
        app:itemIconSize="24dp"
        />

</androidx.drawerlayout.widget.DrawerLayout>