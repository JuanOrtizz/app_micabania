<LinearLayout android:orientation="vertical"
    android:id="@+id/vista_main"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/verdeFondoLogin"
    android:gravity="start"
    android:paddingTop="140dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--Titulo de la seccion iniciar sesion-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inicia Sesión"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="36sp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        />

    <!--LinearLayout para los editText (inputs) del formulario de inicio de sesion-->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginTop="16dp"
        >

        <!--EditText para el email del usuario-->
        <!--EditText para el email del usuario-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:textColorHint ="@color/gris"
            app:hintTextColor ="@color/gris"
            app:boxBackgroundColor="@color/blanco"
            app:boxStrokeColor ="@color/verdePropiedad"
            app:boxStrokeWidth ="0dp"
            app:boxStrokeErrorColor ="@color/rojo"
            app:errorEnabled ="false"
            app:errorTextColor ="@color/rojo"
            android:layout_marginBottom="15dp"
            app:endIconMode="clear_text"
            app:endIconTint = "@color/verdePropiedad"
            app:cursorColor = "@color/verdePropiedad"
            app:cursorErrorColor = "@color/rojo"
            app:counterEnabled="true"
            app:counterMaxLength="320">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--EditText para la contraseña del usuario-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etContraseña"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:textColorHint ="@color/gris"
            app:hintTextColor ="@color/gris"
            app:boxBackgroundColor="@color/blanco"
            app:boxStrokeColor ="@color/verdePropiedad"
            app:boxStrokeWidth ="0dp"
            app:boxStrokeErrorColor ="@color/rojo"
            app:errorEnabled ="false"
            app:errorTextColor ="@color/rojo"
            android:layout_marginBottom="15dp"
            app:endIconTint = "@color/verdePropiedad"
            app:cursorColor = "@color/verdePropiedad"
            app:cursorErrorColor = "@color/rojo"
            app:endIconMode="password_toggle"
            app:counterEnabled="true"
            app:counterMaxLength="30">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <!--Boton para ingresar(iniciar sesion)-->
        <Button
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:id="@+id/botonIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:backgroundTint="@color/verdeClaroBoton"
            android:text="Ingresar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/blanco"
            app:shapeAppearance = "@style/ShapeAppearance.Material3.MediumComponent"
            />

    </LinearLayout>

    <!--LinearLayout para registrarse-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginTop="0dp">

        <!--texto de guia-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿No sos usuario?"
            android:layout_marginEnd="20dp"
            android:textColor="@color/gris"/>

        <!--texto para crear la cuenta-->
        <TextView
            android:id="@+id/botonCrearCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Creá tu cuenta"
            android:layout_marginStart="20dp"
            android:textColor="@color/azul"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>