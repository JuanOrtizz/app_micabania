<!--boton para el elemento en particular que luego abrira un overlay-->
<Button android:id="@+id/btnElemento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="x5 Platos playos"
    android:textStyle="bold"
    android:textSize="16sp"
    android:textColor="@color/blanco"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="32dp"
    android:textAlignment="textStart"
    android:padding="10dp"
    android:backgroundTint="@color/verdeClaroBoton"
    app:icon="@drawable/icon_menu_elemento"
    app:iconGravity="end"
    app:iconTint="@color/blanco"
    app:iconSize="24dp"
    android:maxLines="1"
    android:ellipsize="end"
    android:singleLine="true"
    app:shapeAppearance="@style/ShapeAppearance.Material3.MediumComponent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android" />
