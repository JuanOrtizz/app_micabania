<!--Boton para el boton de la propiedad-->
<Button xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Button.ElevatedButton"
    android:id="@+id/btnPropiedad"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:gravity="start|center_vertical"
    android:padding="12dp"
    android:backgroundTint="@color/verdePropiedad"
    android:text="Casa Grande Nono"
    android:textSize="18sp"
    android:textStyle="bold"
    android:textColor="@color/blanco"
    app:icon="@drawable/icon_propiedad"
    app:iconGravity="textStart"
    app:iconPadding="12dp"
    app:iconTint="@color/blanco"
    app:iconSize="30dp"
    android:maxLines="1"
    android:ellipsize="end"
    app:shapeAppearance="@style/ShapeAppearance.Material3.MediumComponent"
    />